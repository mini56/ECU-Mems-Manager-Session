.warn{background:#342317;border:1px solid #b06b1d;color:#ffe7cc;padding:13px}
.tip{background:#172a24;border:1px solid #3f7763;color:#ddf3e9;padding:12px}
.card{background:#17232b;border:1px solid #354852;padding:13px}
