<RCC>
    <qresource prefix="/icons">
        <file>key.png</file>
        <file>helpbubble.svg</file>
        <file>helpbubble.png</file>
    </qresource>
    <qresource prefix="/flags">
        <file alias="fr.png">flags/fr.png</file>
        <file alias="en.png">flags/en.png</file>
        <file alias="es.png">flags/es.png</file>
        <file alias="it.png">flags/it.png</file>
        <file alias="pt.png">flags/pt.png</file>
        <file alias="de.png">flags/de.png</file>
    </qresource>
    <qresource prefix="/help">
        <file>help.html</file>
        <file>help_en.html</file>
    </qresource>
    <qresource prefix="/help/screens">
        <file alias="overview.jpg">help/images/overview.jpg</file>
        <file alias="settings.jpg">help/images/settings.jpg</file>
        <file alias="faults.jpg">help/images/faults.jpg</file>
        <file alias="diagnostic.jpg">help/images/diagnostic.jpg</file>
        <file alias="measures.jpg">help/images/measures.jpg</file>
        <file alias="rosco.jpg">help/images/rosco.jpg</file>
        <file alias="database.jpg">help/images/database.jpg</file>
        <file alias="analysis.jpg">help/images/analysis.jpg</file>
        <file alias="options.jpg">help/images/options.jpg</file>
    </qresource>
</RCC>
